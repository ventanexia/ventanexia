{
  "edition": "master",
  "description": "Catálogo maestro de capacidades de VentaNexIA. La edición interna mantiene todas las funciones; las instalaciones de clientes reciben únicamente los módulos contratados mediante entitlements del backend.",
  "modules": [
    {
      "id": "core_ai",
      "name": "Asistente IA",
      "category": "core",
      "defaultEnabled": true,
      "capabilities": ["chat", "authorized_files", "local_data_discovery", "activity_log"]
    },
    {
      "id": "email_agent",
      "name": "Email",
      "category": "communications",
      "connectors": ["gmail", "microsoft_365", "imap_smtp"],
      "capabilities": ["read_authorized_mail", "draft", "reply", "send_with_policy", "classify", "follow_up", "attachments"]
    },
    {
      "id": "whatsapp_agent",
      "name": "WhatsApp Business",
      "category": "communications",
      "connectors": ["meta_whatsapp_business_platform", "approved_provider"],
      "capabilities": ["inbox", "automatic_replies", "lead_qualification", "customer_service", "handoff_to_human", "templates", "conversation_log"]
    },
    {
      "id": "social_agent",
      "name": "Redes sociales",
      "category": "marketing",
      "connectors": ["facebook", "instagram", "linkedin", "other_supported_apis"],
      "capabilities": ["create_content", "schedule", "publish", "reply_supported_channels", "content_calendar", "performance_summary"]
    },
    {
      "id": "prospecting_agent",
      "name": "Captación y búsqueda de clientes",
      "category": "sales",
      "capabilities": ["prospect_research", "lead_lists", "qualification", "crm_sync", "outreach_drafts", "follow_up_sequences"]
    },
    {
      "id": "crm_agent",
      "name": "CRM y clientes",
      "category": "sales",
      "connectors": ["hubspot", "other_supported_crm"],
      "capabilities": ["contacts", "companies", "deals", "tasks", "notes", "pipeline_updates", "customer_metrics"]
    },
    {
      "id": "web_ecommerce_agent",
      "name": "Web & Ecommerce",
      "category": "web",
      "commercialAddon": {
        "name": "Agente Web & Ecommerce",
        "priceMonthlyEur": 550
      },
      "connectors": ["shopify", "wordpress_woocommerce", "github_vercel", "supported_cms_api"],
      "capabilities": [
        "orders_today",
        "revenue_period",
        "new_customers",
        "catalog_read",
        "product_updates",
        "stock_updates",
        "price_updates",
        "content_changes",
        "theme_content_changes",
        "page_creation",
        "page_modification",
        "navigation_updates",
        "seo_updates",
        "customer_queries",
        "website_form_responses",
        "order_control",
        "store_reporting",
        "preview_before_sensitive_changes",
        "audit_log"
      ]
    },
    {
      "id": "support_agent",
      "name": "Soporte y asistencia",
      "category": "support",
      "capabilities": ["customer_id", "device_id", "remote_assistance_with_consent", "incident_history", "diagnostics", "audit_log"]
    }
  ],
  "licensing": {
    "customerIdRequired": true,
    "deviceIdRequired": true,
    "serverSideEntitlements": true,
    "masterEditionAllModules": true,
    "clientEditionOnlyPurchasedModules": true,
    "revocationSupported": true,
    "devicePolicy": {
      "enforcement": "server_side",
      "oneInstallationConsumesOneDeviceSeat": true,
      "deviceMustBeRegisteredToCustomer": true,
      "newDeviceRequiresAvailableSeat": true,
      "customerCanDeactivateOldDevice": true,
      "supportCanRevokeDevice": true,
      "deviceSeatPricing": {
        "currency": "EUR",
        "extraDeviceMonthlyEur": 49,
        "status": "initial_commercial_proposal"
      },
      "includedDevicesByPlan": {
        "start": 1,
        "core": 3,
        "scale": 5
      }
    }
  },
  "security": {
    "oauthPreferred": true,
    "secretsStoredEncrypted": true,
    "leastPrivilege": true,
    "explicitConsentForLocalAccess": true,
    "sensitiveWriteActionsCanRequireApproval": true,
    "fullAuditTrail": true
  }
}
