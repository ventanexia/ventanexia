HUBSPOT_ACCESS_TOKEN=
OPENAI_API_KEY=
# Optional. The safe default is openai/gpt-5-mini through Vercel AI Gateway.
OPENAI_MODEL=openai/gpt-5-mini
AI_GATEWAY_API_KEY=
BOOKING_URL=

# Internal orchestration
AUTOMATION_WEBHOOK_SECRET=
N8N_AUTOMATION_WEBHOOK=

# Stripe - never expose these in browser code
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy Core aliases; leave blank when the plan-specific variables below are set.
STRIPE_PRICE_SETUP=
STRIPE_PRICE_MONTHLY=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=

# VNX Control Center
# Preferred: scrypt hash generated with scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
# Legacy fallback only; remove after ADMIN_PASSWORD_HASH is configured
ADMIN_PASSWORD=
# Separate 32+ character secret; never reuse PORTAL_SESSION_SECRET
ADMIN_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CUSTOMER_PORTAL_RETURN_URL=https://www.ventanexia.es/

# Trial/licensing
CRON_SECRET=

# Anti-abuse: long random secret used only to HMAC trial identity signals
TRIAL_ABUSE_SECRET=

STRIPE_PRICE_START_MONTHLY=
STRIPE_PRICE_START_SETUP=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_SETUP=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_SETUP=
STRIPE_PRICE_EXTRA_AGENT=

PORTAL_SESSION_SECRET=
# Must be different from ADMIN_SESSION_SECRET and at least 32 characters
PUBLIC_APP_URL=https://ventanexia.vercel.app

# V21 security / launch hardening
# At least 32 random characters. Binds a trial activation to the exact solution request/email.
TRIAL_SIGNING_SECRET=

# Optional technical fair-use action caps. Leave blank until commercial limits are approved.
VNX_MONTHLY_ACTION_BUDGET_START=
VNX_MONTHLY_ACTION_BUDGET_CORE=
VNX_MONTHLY_ACTION_BUDGET_SCALE=
VNX_MONTHLY_ACTION_BUDGET_ENTERPRISE=
